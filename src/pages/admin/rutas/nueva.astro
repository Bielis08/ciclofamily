---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Nueva ruta - Admin">
  <div class="mb-6">
    <a href="/admin/rutas" class="text-page-300 hover:underline text-sm inline-flex items-center gap-1">
      ← Volver a rutas
    </a>
  </div>

  <h1 class="text-2xl font-bold mb-6">Nueva ruta</h1>

  <div id="success-msg" class="hidden bg-green-50 border border-green-300 text-green-700 rounded-lg px-4 py-3 mb-4">Ruta creada correctamente</div>
  <div id="error-msg" class="hidden bg-red-50 border border-red-300 text-red-700 rounded-lg px-4 py-3 mb-4"></div>

  <form id="ruta-form" class="space-y-6">
    <!-- Datos basicos -->
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <h2 class="font-semibold text-lg mb-4">Datos de la ruta</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label for="titulo" class="block text-sm font-medium text-gray-700 mb-1">Titulo *</label>
          <input type="text" id="titulo" name="titulo" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none" />
        </div>
        <div>
          <label for="destino" class="block text-sm font-medium text-gray-700 mb-1">Destino *</label>
          <input type="text" id="destino" name="destino" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none" />
        </div>
        <div>
          <label for="dificultad" class="block text-sm font-medium text-gray-700 mb-1">Dificultad *</label>
          <select id="dificultad" name="dificultad" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none">
            <option value="Facil">Facil</option>
            <option value="Moderada">Moderada</option>
            <option value="Dificil">Dificil</option>
          </select>
        </div>
        <div>
          <label for="distancia" class="block text-sm font-medium text-gray-700 mb-1">Distancia (km)</label>
          <input type="number" step="0.1" id="distancia" name="distancia" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none" />
        </div>
        <div>
          <label for="desnivel" class="block text-sm font-medium text-gray-700 mb-1">Desnivel (m)</label>
          <input type="number" id="desnivel" name="desnivel" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none" />
        </div>
        <div class="sm:col-span-2">
          <label for="wikiloc" class="block text-sm font-medium text-gray-700 mb-1">URL Wikiloc</label>
          <input type="url" id="wikiloc" name="wikiloc" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none" placeholder="https://es.wikiloc.com/..." />
        </div>
        <div class="sm:col-span-2">
          <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripcion (Markdown)</label>
          <textarea id="descripcion" name="descripcion" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-page-300 focus:border-page-300 outline-none font-mono text-sm"></textarea>
        </div>
      </div>
    </div>

    <!-- Archivos -->
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <h2 class="font-semibold text-lg mb-4">Archivos</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="gpx" class="block text-sm font-medium text-gray-700 mb-1">Archivo GPX *</label>
          <input type="file" id="gpx" name="gpx" accept=".gpx" required class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-page-200 file:text-page-400 hover:file:bg-page-300 file:cursor-pointer" />
          <p id="gpx-name" class="text-xs text-gray-500 mt-1"></p>
        </div>
        <div class="sm:col-span-2">
          <label for="galeria" class="block text-sm font-medium text-gray-700 mb-1">Imagenes *</label>
          <p class="text-xs text-gray-500 mb-1">La primera imagen sera la portada. Arrastra para reordenar.</p>
          <input type="file" id="galeria" name="galeria" accept="image/*" multiple required class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-page-200 file:text-page-400 hover:file:bg-page-300 file:cursor-pointer" />
          <div id="galeria-preview" class="mt-2 grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
        </div>
      </div>
    </div>

    <!-- Submit -->
    <div class="flex gap-3">
      <button type="submit" id="submit-btn" class="bg-page-400 text-white px-6 py-2.5 rounded-lg hover:bg-page-300 transition font-medium disabled:opacity-50 disabled:cursor-not-allowed">
        Crear ruta
      </button>
      <a href="/admin/rutas" class="px-6 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition font-medium text-gray-700">
        Cancelar
      </a>
    </div>
  </form>

  <!-- Confirm modal -->
  <div id="confirm-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-xl">
      <h3 class="text-lg font-semibold mb-2">Crear ruta?</h3>
      <p class="text-gray-600 mb-6">Se creara la ruta con los datos indicados.</p>
      <div class="flex gap-3 justify-end">
        <button id="cancel-confirm" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition">Cancelar</button>
        <button id="do-confirm" class="px-4 py-2 bg-page-400 text-white rounded-lg hover:bg-page-300 transition font-medium">Crear</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .draggable-preview {
    transition: transform 0.2s cubic-bezier(.25,.8,.25,1), box-shadow 0.2s ease, opacity 0.2s ease;
    border: 2px solid transparent;
  }
  .draggable-preview:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
  .draggable-preview.drag-source {
    opacity: 0.35;
    transform: scale(0.92);
    box-shadow: 0 0 0 2px #3cc347;
  }
  .draggable-preview.drag-over {
    outline: 2.5px dashed #3cc347;
    outline-offset: 3px;
    transform: scale(1.05);
    background: rgba(60,195,71,0.08);
  }
  .touch-dragging {
    position: fixed; z-index: 9999; pointer-events: none;
    opacity: 0.92; transform: scale(1.1) rotate(2deg);
    box-shadow: 0 12px 32px rgba(0,0,0,0.35), 0 0 0 2px rgba(60,195,71,0.5);
    border-radius: 0.5rem;
    transition: none;
  }
  .drop-indicator {
    position: absolute; width: 3px; background: #3cc347; border-radius: 2px;
    pointer-events: none; z-index: 10;
    box-shadow: 0 0 6px rgba(60,195,71,0.6);
  }
</style>

<script>
  const form = document.getElementById("ruta-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const errorDiv = document.getElementById("error-msg")!;
  let pendingFiles: File[] = [];

  function rebuildPreview() {
    const container = document.getElementById("galeria-preview")!;
    container.innerHTML = "";
    if (pendingFiles.length === 0) return;

    const wrappers: HTMLDivElement[] = [];

    pendingFiles.forEach((file, idx) => {
      const wrapper = document.createElement("div");
      wrapper.className = "relative cursor-grab active:cursor-grabbing draggable-preview group";
      wrapper.dataset.index = String(idx);
      wrapper.draggable = true;

      const img = document.createElement("img");
      img.className = "w-full h-24 object-cover rounded-lg pointer-events-none bg-gray-100";
      img.alt = file.name;
      wrapper.appendChild(img);

      if (idx === 0) {
        const badge = document.createElement("span");
        badge.className = "absolute top-1 left-1 bg-page-300 text-white text-[10px] px-1.5 py-0.5 rounded pointer-events-none z-10";
        badge.textContent = "Portada";
        wrapper.appendChild(badge);
      }

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs opacity-60 hover:opacity-100 transition remove-preview";
      removeBtn.textContent = "x";
      wrapper.appendChild(removeBtn);

      wrappers.push(wrapper);
      container.appendChild(wrapper);

      const reader = new FileReader();
      reader.onload = (ev) => { img.src = ev.target!.result as string; };
      reader.readAsDataURL(file);

      wrapper.addEventListener("dragstart", (e) => {
        wrapper.classList.add("drag-source");
        e.dataTransfer!.effectAllowed = "move";
        e.dataTransfer!.setData("text/plain", String(idx));
      });
      wrapper.addEventListener("dragover", (e) => {
        e.preventDefault();
        e.dataTransfer!.dropEffect = "move";
      });
      wrapper.addEventListener("dragenter", (e) => {
        e.preventDefault();
        wrapper.classList.add("drag-over");
      });
      wrapper.addEventListener("dragleave", () => wrapper.classList.remove("drag-over"));
      wrapper.addEventListener("drop", (e) => {
        e.preventDefault();
        e.stopPropagation();
        wrapper.classList.remove("drag-over");
        const fromIdx = parseInt(e.dataTransfer!.getData("text/plain"));
        const toIdx = idx;
        if (fromIdx !== toIdx) {
          const [moved] = pendingFiles.splice(fromIdx, 1);
          pendingFiles.splice(toIdx, 0, moved);
          rebuildPreview();
        }
      });
      wrapper.addEventListener("dragend", () => {
        document.querySelectorAll(".draggable-preview").forEach((el) => el.classList.remove("drag-source", "drag-over"));
      });

      // Touch drag
      let pTouchStartY = 0;
      let pTouchStartX = 0;
      let pTouchMoved = false;
      let pGhost: HTMLElement | null = null;
      wrapper.addEventListener("touchstart", (e) => {
        if ((e.target as HTMLElement).closest(".remove-preview")) return;
        pTouchStartY = e.touches[0].clientY;
        pTouchStartX = e.touches[0].clientX;
        pTouchMoved = false;
      }, { passive: true });
      wrapper.addEventListener("touchmove", (e) => {
        if ((e.target as HTMLElement).closest(".remove-preview")) return;
        const touch = e.touches[0];
        const dy = Math.abs(touch.clientY - pTouchStartY);
        const dx = Math.abs(touch.clientX - pTouchStartX);
        if (!pTouchMoved && (dy > 5 || dx > 5)) pTouchMoved = true;
        if (!pTouchMoved) return;
        e.preventDefault();
        if (!pGhost) {
          pGhost = wrapper.cloneNode(true) as HTMLElement;
          pGhost.classList.add("touch-dragging");
          pGhost.style.width = wrapper.offsetWidth + "px";
          pGhost.style.height = wrapper.offsetHeight + "px";
          document.body.appendChild(pGhost);
          wrapper.classList.add("drag-source");
        }
        pGhost.style.left = (touch.clientX - wrapper.offsetWidth / 2) + "px";
        pGhost.style.top = (touch.clientY - wrapper.offsetHeight / 2) + "px";
        pGhost.style.display = "none";
        const below = document.elementFromPoint(touch.clientX, touch.clientY);
        pGhost.style.display = "";
        document.querySelectorAll(".draggable-preview").forEach((el) => el.classList.remove("drag-over"));
        const tgt = below?.closest(".draggable-preview");
        if (tgt && tgt !== wrapper) tgt.classList.add("drag-over");
      }, { passive: false });
      wrapper.addEventListener("touchend", (e) => {
        if (pGhost) { pGhost.remove(); pGhost = null; }
        wrapper.classList.remove("drag-source");
        document.querySelectorAll(".draggable-preview").forEach((el) => el.classList.remove("drag-over"));
        if (!pTouchMoved) return;
        const touch = e.changedTouches[0];
        const below = document.elementFromPoint(touch.clientX, touch.clientY);
        const tgt = below?.closest(".draggable-preview");
        if (tgt && tgt !== wrapper) {
          const toIdx = parseInt((tgt as HTMLElement).dataset.index!);
          const [moved] = pendingFiles.splice(idx, 1);
          pendingFiles.splice(toIdx, 0, moved);
          rebuildPreview();
        }
      });

      removeBtn.addEventListener("click", () => {
        pendingFiles.splice(idx, 1);
        rebuildPreview();
      });
    });
  }

  document.getElementById("gpx")!.addEventListener("change", (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    document.getElementById("gpx-name")!.textContent = file ? file.name : "";
  });

  document.getElementById("galeria")!.addEventListener("change", (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files) {
      pendingFiles = Array.from(files);
      rebuildPreview();
    }
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    document.getElementById("confirm-modal")!.classList.remove("hidden");
  });

  document.getElementById("cancel-confirm")!.addEventListener("click", () => {
    document.getElementById("confirm-modal")!.classList.add("hidden");
  });

  document.getElementById("confirm-modal")!.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) {
      document.getElementById("confirm-modal")!.classList.add("hidden");
    }
  });

  document.getElementById("do-confirm")!.addEventListener("click", async () => {
    document.getElementById("confirm-modal")!.classList.add("hidden");
    errorDiv.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = "Creando...";

    const formData = new FormData(form);
    formData.delete("galeria");
    pendingFiles.forEach((f) => formData.append("galeria", f));

    try {
      const res = await fetch("/api/admin/rutas", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (!res.ok) {
        errorDiv.textContent = data.error || "Error al crear la ruta";
        errorDiv.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Crear ruta";
        return;
      }

      window.location.href = "/admin/rutas";
    } catch {
      errorDiv.textContent = "Error de conexion";
      errorDiv.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Crear ruta";
    }
  });
</script>